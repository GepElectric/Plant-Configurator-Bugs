","Number":"96","ProgrammingLanguage":"FBD"},{"Name":"FB_OBJECT_MULTI_CONTACTOR_ERROR","Path":"OBJECTS\\CONTACTOR_ERROR\\FB_OBJECT_MULTI_CONTACTOR_ERROR","Kind":"FB","Number":"123","ProgrammingLanguage":"FBD"}]}],"ScadaBindings":[{"ScadaDatabaseId":"20f7fbc7bf3945e69433c1d06b1f9d6d","ScadaName":"SCADA 1","DeviceName":"","SyncState":"Not mapped"}]},"DescriptionTextLists":{"WorkbookPath":"","TextLists":{"SourcePath":"","Languages":[],"AllListNames":[],"Lists":{},"References":{},"Comments":{}},"Mappings":[{"PlcDatabaseId":"d8eba22c90af4a80af71bb0b24e9ce6a","PlcName":"Unit","AlmDescriptionsList":"","ParDescriptionsList":"","SequenceControlStatusList":"","SequenceCommandList":"","AlmBlockingClassList":"","CabinetsList":"","PortConfigurationList":"","SeqCmdList":"","SeqConfigList":""}]},"DescriptionTemplates":{"Templates":[{"Key":"Communication error","Scope":"ALM","Notes":"","TextEnglish":"Alarm is triggered when a communication error occurs with the device. This can happen due to issues with cable termination or damage to the communication module on the device.","TextOther":""},{"Key":"Contactor error","Scope":"ALM","Notes":"","TextEnglish":"Alarm is triggered when the contactor activation command is activated, and the contactor does not carry out the requested operation within the time limit set in system parameters. Conversely, an alarm is also triggered when the contactor activation command is not activated, and the contactor is on. This could be due to intentional handling, wire break or a malfunction of the contactor or auxiliary contacts.","TextOther":""},{"Key":"Device fault","Scope":"ALM","Notes":"","TextEnglish":"Alarm is triggered when the live contact of the protection device is not active, indicating a potential fault status.","TextOther":""},{"Key":"MCB Group trip","Scope":"ALM","Notes":"","TextEnglish":"Alarm is triggered when at least one MCBs in the group is off. This could be due to intentional handling, wire breakage, or a malfunction of auxiliary contacts.","TextOther":""},{"Key":"MCB OFF","Scope":"ALM","Notes":"","TextEnglish":"Alarm is triggered when MCB is off. This could be due to intentional handling, wire break or a malfunction of auxiliary contacts.","TextOther":""},{"Key":"Meas high ANA/DIG","Scope":"ALM","Notes":"","TextEnglish":"Alarm is triggered when the measurement surpasses the high-value threshold set in the system parameters, or digital signal is indicating that the measured value has high value.","TextOther":""},{"Key":"Meas too high ANA/DIG","Scope":"ALM","Notes":"","TextEnglish":"Alarm is triggered when the measurement surpasses a threshold set to be excessively high in the system parameters, or digital signal is indicating that the measured value has very high value.","TextOther":""},{"Key":"Meas too low ANA/DIG","Scope":"ALM","Notes":"","TextEnglish":"Alarm is triggered when the measurement falls below a threshold that is set to be excessively low in the system parameters, or digital signal is indicating that the measured value has very low value.","TextOther":""},{"Key":"Measurement high","Scope":"ALM","Notes":"","TextEnglish":"Alarm is triggered when the measurement surpasses the high-value threshold set in the system parameters.","TextOther":""},{"Key":"Measurement low","Scope":"ALM","Notes":"","TextEnglish":"Alarm is triggered when the measurement falls below the low-value threshold set in the system parameters.","TextOther":""},{"Key":"Measurement too high","Scope":"ALM","Notes":"","TextEnglish":"Alarm is triggered when the measurement surpasses a threshold set to be excessively high in the system parameters.","TextOther":""},{"Key":"Measurement too low","Scope":"ALM","Notes":"","TextEnglish":"Alarm is triggered when the measurement falls below a threshold that is set to be excessively low in the system parameters.","TextOther":""},{"Key":"Positioning error","Scope":"ALM","Notes":"","TextEnglish":"Alarm is triggered when the absolute difference between the measured position and the reference value is higher than the limit. ","TextOther":""},{"Key":"Sensor error mA","Scope":"ALM","Notes":"","TextEnglish":"Alarm is triggered when the current signal exceeds the nominal limits, which are 4mA and 20mA. Possible causes for this anomaly include issues such as improper cable termination at the measuring point, damage to the sensor or wire break.","TextOther":""},{"Key":"Sequence too long","Scope":"ALM","Notes":"","TextEnglish":"Alarm is triggered when the sequence duration surpasses the duration set in the system parameters.","TextOther":""},{"Key":"Step too long","Scope":"ALM","Notes":"","TextEnglish":"Alarm is triggered when the sequence step duration surpasses the duration set in the sequence parameters.","TextOther":""}]},"AlmParExport":{"DocNumber":"","Author":"","DocDate":"","PlantFullName":"","CustomerBlock":"","FbNumber":"01","ExportLanguageCode":"en-US","ExportLanguage":"ENG","ExportPdf":true,"ExportDocx":true,"LastOutputPath":"","PlcMappings":[{"PlcDatabaseId":"d8eba22c90af4a80af71bb0b24e9ce6a","PlcName":"Unit","Include":true,"ExportAlm":true,"ExportPar":true,"AlmExcludeSpec":"","ParExcludeSpec":""}]},"EplanImport":{"LastEpjPath":"","Assignments":[],"Synonyms":[{"Words":"CB","Means":"CIRCUIT BREAKER"},{"Words":"GCB","Means":"GENERATOR CIRCUIT BREAKER"},{"Words":"MCB","Means":"MINIATURE CIRCUIT BREAKER"},{"Words":"TIV","Means":"TURBINE INLET VALVE"},{"Words":"MIV","Means":"MAIN INLET VALVE"},{"Words":"TRAFO","Means":"TRANSFORMER"},{"Words":"GEN","Means":"GENERATOR"},{"Words":"MEAS","Means":"MEASUREMENT"},{"Words":"TEMP","Means":"TEMPERATURE"},{"Words":"PRESS","Means":"PRESSURE"},{"Words":"POS","Means":"POSITION"},{"Words":"VIB","Means":"VIBRATION"},{"Words":"LUBRIFICATION","Means":"LUBRICATION"},{"Words":"BUCHOLZ","Means":"BUCHHOLZ"},{"Words":"RAISE","Means":"UP"},{"Words":"HIGHER","Means":"UP"},{"Words":"FASTER","Means":"UP"},{"Words":"INCREASE","Means":"UP"},{"Words":"LOWER","Means":"DOWN"},{"Words":"SLOWER","Means":"DOWN"},{"Words":"DECREASE","Means":"DOWN"},{"Words":"CLOSE","Means":"CLOSED"},{"Words":"OPENED","Means":"OPEN"},{"Words":"AUTO","Means":"AUTOMATIC"},{"Words":"MAN","Means":"MANUAL"},{"Words":"ESD","Means":"EMERGENCY SHUTDOWN"},{"Words":"QSD","Means":"QUICK SHUTDOWN"},{"Words":"NSD","Means":"NORMAL SHUTDOWN"},{"Words":"PSU","Means":"POWER SUPPLY"},{"Words":"PS","Means":"POWER SUPPLY"},{"Words":"PB","Means":"PUSHBUTTON"},{"Words":"PUSH BUTTON","Means":"PUSHBUTTON"}],"LearnedNames":[]}}
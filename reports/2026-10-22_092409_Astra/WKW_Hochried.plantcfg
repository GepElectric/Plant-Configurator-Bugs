ang \u201ETotbandbreite\u201C bestimmt die Gr\u00F6\u00DFe des Totbandes.","DescriptionTemplateKey":"","DescriptionTemplateOptOut":false,"DescriptionDirty":false,"HasValidationError":false},{"Id":625,"PlcStructure":"PID_WATER_LEVEL","PlcName":"LMN_HLM","SystemNameEnglish":"","NameEnglish":"Water level PID high limit of manipulated value","SystemNameOther":"","NameOther":"Wasserstand PID obere Grenze der Stellgr\u00F6\u00DFe","Unit":"15","TrueText":"","ModuleName":"","ModulePort":null,"EplanSignal":"","EplanConnectedTo":"","ColorValue0":"","ColorValue1":"","AlarmConfig":"","AlarmInvert":"","AlarmId":"","ExtraColumn1":"","ExtraColumn2":"","LoggingEnable":"","LoggingTime":"","Type":"","AlarmControl":"","SrAlarm":"","AlarmClass":"","ReactToUnit":"","Spare":"","BlockingClass1":"","BlockingClass2":"","Delay":"","TimeBase":"","SourceType":"","SourceDigId":"","SourceAnaId":"","Used":"1","InUse":"1","ParameterType":"0","IntegerValue":"0","TimeValue":"T#0MS","RealValue":"100.0","MinValue":"0.0","MaxValue":"0.0","LimitLlEnabled":false,"LimitLoEnabled":false,"LimitHiEnabled":false,"LimitHhEnabled":false,"AlarmErrId":"","AlarmLlId":"","AlarmLoId":"","AlarmHiId":"","AlarmHhId":"","ParVal1Id":"","ParVal2Id":"","ParOffsetId":"","ParScaleFactorId":"","ParLlId":"","ParLoId":"","ParHiId":"","ParHhId":"","Ordinator":"","DescriptionEnglish":"The manipulated value is always restricted to a high limit and low limit. The \u0022High limit of manipulated value\u0022 input specifies the high limit.","DescriptionOther":"Der Stellwert wird immer auf eine Obergrenze und eine Untergrenze begrenzt. Der Eingang \u201EObergrenze Stellwert\u201C legt die Obergrenze fest.","DescriptionTemplateKey":"","DescriptionTemplateOptOut":false,"DescriptionDirty":false,"HasValidationError":false},{"Id":626,"PlcStructure":"PID_WATER_LEVEL","PlcName":"LMN_LLM","SystemNameEnglish":"","NameEnglish":"Water level PID low limit of manipulated value","SystemNameOther":"","NameOther":"Wasserstand PID untere Grenze der St